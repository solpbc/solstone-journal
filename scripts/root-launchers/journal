quote_arg() {
    arg=$1
    printf "'"
    while :; do
        case "$arg" in
            *\'*)
                prefix="${arg%%\'*}"
                printf "%s'\\\\''" "$prefix"
                arg="${arg#*\'}"
                ;;
            *)
                printf "%s" "$arg"
                break
                ;;
        esac
    done
    printf "'"
}

if [ "$#" -eq 0 ]; then
    printf "the 'journal' command has moved. run:\n  solstone journal\n" >&2
else
    printf "the 'journal' command has moved. run:\n  solstone journal" >&2
    for arg in "$@"; do
        printf ' ' >&2
        quote_arg "$arg" >&2
    done
    printf '\n' >&2
fi
exit 1
