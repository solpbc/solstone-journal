id=solstone

# A mac's command line ships inside the journal app, so that is what to reinstall.
reinstall() {
    case $(uname -s) in
        Darwin) printf 'Reinstall the journal app.' ;;
        *) printf 'Reinstall solstone and solstone-core-sol.' ;;
    esac
}

p=$0
n=0
while [ -L "$p" ]; do
    n=$((n + 1))
    if [ "$n" -gt 40 ]; then
        printf '%s: native launcher symlink cycle detected. %s\n' "$id" "$(reinstall)" >&2
        exit 78
    fi
    t=$(readlink -- "$p") || {
        printf '%s: native launcher symlink is dangling: %s. %s\n' "$id" "$p" "$(reinstall)" >&2
        exit 78
    }
    case $t in
        /*) p=$t ;;
        *) p=$(dirname -- "$p")/$t ;;
    esac
done

if [ ! -f "$p" ]; then
    printf '%s: native launcher symlink is dangling: %s. %s\n' "$id" "$p" "$(reinstall)" >&2
    exit 78
fi

d=$(cd -P -- "$(dirname -- "$p")" && pwd) || {
    printf '%s: native launcher symlink is dangling: %s. %s\n' "$id" "$p" "$(reinstall)" >&2
    exit 78
}
core=$d/solstone-core-sol

if [ ! -e "$core" ]; then
    printf '%s: native solstone-core-sol sibling is missing: %s. %s\n' "$id" "$core" "$(reinstall)" >&2
    exit 78
fi
if [ ! -f "$core" ] || [ ! -x "$core" ]; then
    printf '%s: native solstone-core-sol sibling is not executable: %s. %s\n' "$id" "$core" "$(reinstall)" >&2
    exit 78
fi

exec "$core" "$@"
