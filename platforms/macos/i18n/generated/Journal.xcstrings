    "m6a6f75726e616c2e6d61632e6c6f636174696f6e2e6e65772e6a6f75726e616c2e686f737465642e7368617265": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "if you restore this journal's backup there, the new journal takes it over, and this one stops backing up until you turn it on again."
          }
        }
      }
    },
    "m6a6f75726e616c2e6d61632e6c6f636174696f6e2e6f746865722e6a6f75726e616c73": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "other journals on this mac"
