      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "both have the same mark, so your devices reach whichever one is running."
          }
        }
      }
    },
    "m6a6f75726e616c2e6d61632e6c6f636174696f6e2e7368617265642e686f737465642e74656d706c617465": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "the one in %1$@ shares this encrypted backup operated by sol pbc, and only one can use it. if this journal stops backing up, turn it on again in the backup pane."
          }
        }
      }
    },
    "m6a6f75726e616c2e6d61632e6c6f636174696f6e2e73746172742e6e65772e6a6f75726e616c": {
