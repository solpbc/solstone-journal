# Package data inclusion. Paired with `include-package-data = true` in
# pyproject.toml ([tool.setuptools]). We graft the entire solstone/ tree so every
# non-Python data file ships automatically — no hand-curated per-subdir globs to
# forget. Curated globs repeatedly dropped files added in new subdirectories (the
# installed wheel silently omitted them while source-tree CI stayed green); graft
# removes that failure mode at the root.
graft solstone
include build_hooks.py
include scripts/root-launchers/sol
include scripts/root-launchers/solstone

# Exclude only compiled/editor cruft.
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude .gitignore
recursive-exclude solstone *.rs
recursive-exclude solstone authority.toml

# The Swift helper lives under core/crates/solstone-core-transcribe/parakeet-helper
# and is not part of the Python graft.
