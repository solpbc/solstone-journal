{
  "contract": "solstone-journal-at-rest",
  "contract_version": 1,
  "description": "Generated journal at-rest contract bundle. Do not hand-edit; regenerate with `python -m solstone.think.contract_cli build`.",
  "generated_by": "python -m solstone.think.contract_cli build",
  "layout": {
    "description": "Journal producer-facing layout lifecycle. Read paths remain broader than producer write paths for legacy compatibility.",
    "lifecycle": [
      {
        "notes": "Local observers may assemble incomplete segment contents under a draft key before upload or finalization.",
        "producer_write_paths": [
          "chronicle/YYYYMMDD/{stream}/HHMMSS_draft/"
        ],
        "segment_key": "HHMMSS_draft",
        "stage": "draft"
      },
      {
        "notes": "Native observers submit a normalized segment envelope plus files; the journal validates before writing.",
        "producer_write_paths": [
          "POST /app/observer/ingest multipart fields day, segment, stream/meta, files[]"
        ],
        "stage": "upload-envelope"
      },
      {
        "legacy_read_paths": [
          "chronicle/YYYYMMDD/HHMMSS_LEN/{stream.json,audio.jsonl,screen.jsonl}",
          "chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/{source}_audio.jsonl",
          "chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/{source}_transcript.jsonl",
          "chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/{position}_{connector}_screen.jsonl"
        ],
        "notes": "Accepted producer paths are stream-qualified. Readers tolerate older flat and prefixed names.",
        "producer_write_paths": [
          "chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/{stream.json,ingest.json,audio.jsonl,screen.jsonl}",
          "chronicle/YYYYMMDD/{host}.browser/HHMMSS_LEN/browser_{host-slug}.jsonl"
        ],
        "stage": "accepted"
      },
      {
        "notes": "Finalized segment keys carry start time and duration, with no per-record schema_version.",
        "producer_write_paths": [
          "chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/"
        ],
        "segment_key": "HHMMSS_LEN",
        "stage": "finalized"
      }
    ]
  },
  "schemas": {
    "audio-jsonl": {
      "schema": {
        "$defs": {
          "header": {
            "additionalProperties": true,
            "properties": {
              "backend": {
                "type": "string"
              },
              "duration": {
                "type": "number"
              },
              "facet": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "imported": {
                "additionalProperties": true,
                "type": "object"
              },
              "model": {
                "type": "string"
              },
              "noisy": {
                "type": "boolean"
              },
              "observer": {
                "type": "string"
              },
              "raw": {
                "type": "string"
              },
              "setting": {
                "type": "string"
              },
              "sound_tags": {
                "additionalProperties": true,
                "properties": {
                  "agg": {
                    "type": "string"
                  },
                  "engine": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "tags": {
                    "additionalProperties": {
                      "type": "number"
                    },
                    "type": "object"
                  },
                  "threshold": {
                    "type": "number"
                  },
                  "window_s": {
                    "type": "number"
                  },
                  "windows": {
                    "type": "integer"
                  }
                },
                "required": [
                  "engine",
                  "model",
                  "threshold",
                  "window_s",
                  "agg",
                  "windows",
                  "tags"
                ],
                "type": "object"
              },
              "speaker_evidence": {
                "description": "Windowed slot evidence decision from native speaker analysis. This records engagement, not clustering outcome: a multi value with no integer speaker labels means diarization engaged and clustering produced nothing or failed.",
                "enum": [
                  "single",
                  "multi",
                  "none"
                ],
                "type": "string"
              },
              "speaker_evidence_multi_fraction": {
                "description": "Fraction of speech-bearing pyannote windows with multi-speaker slot evidence. This records engagement evidence, not clustering outcome.",
                "type": "number"
              },
              "speaker_evidence_version": {
                "const": "windowed-slots-v1",
                "description": "Version of the speaker-evidence decision contract, pinned to windowed-slots-v1 so readers can gate interpretation.",
                "type": "string"
              },
              "topics": {
                "type": "array"
              },
              "warning": {
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          },
          "record": {
            "additionalProperties": true,
            "properties": {
              "corrected": {
                "type": "string"
              },
              "emotion": {
                "type": "string"
              },
              "sentence_id": {
                "type": "integer"
              },
              "source": {
                "type": "string"
              },
              "speaker": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "start": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "start",
              "text"
            ],
            "type": "object"
          }
        },
        "$id": "solstone-journal-format:audio-jsonl",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": true,
        "title": "Audio transcript JSONL",
        "type": "object",
        "x-journal-contract": {
          "allowed_producers": [
            "journal transcriber",
            "native observers via ingest"
          ],
          "file_kind": "headered_jsonl",
          "format_id": "audio-jsonl",
          "key_fields": [
            "header.raw",
            "record.start",
            "record.text",
            "record.sentence_id",
            "record.corrected",
            "record.source",
            "record.speaker",
            "record.emotion"
          ],
          "legacy_read_paths": [
            "chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/{source}_audio.jsonl"
          ],
          "producer_write_paths": [
            "chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/audio.jsonl"
          ],
          "reference_writer": "solstone-core speaker-transcript-write",
          "schema_owner": "observe.transcribe",
          "write_discipline": "headered_jsonl atomic whole-file replace"
        }
      },
      "source": "solstone/observe/transcribe/audio.schema.json"
    },
