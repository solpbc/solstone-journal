journal.window.system.health.backlog.day.this.day.s.remaining.content.still.will.not.fit.the.on.device.model.aft = el contenido restante de este día todavía no va a caber en el modelo en el dispositivo después del recorte. va a seguir reintentando

journal.window.system.health.backlog.day.waiting.to.retry.automatically.no.action.needed.yet = en espera de reintentar automáticamente. todavía no hace falta ninguna acción

journal.window.system.health.backlog.day.your.ai.provider.turned.down.your.key.check.it.on.the.thinking.page = tu proveedor de AI rechazó tu clave. revísala en la página de razonamiento

journal.window.system.health.backlog.verdict.age.unknown = sin una hora confiable de su última actualización de estado, tu diario no puede saber si está al día.

journal.window.system.health.backlog.verdict.all.caught.up = tu diario ya está al día.

journal.window.system.health.backlog.verdict.caught.up = tu diario está al día.

journal.window.system.health.backlog.verdict.mixed = { $stuck_quantity ->
    [one] 1 día necesita ayuda. { $pending_quantity ->
        [one] 1 día más todavía se está poniendo al día.
        [many] { $pending_days } días más todavía se están poniendo al día.
       *[other] { $pending_days } días más todavía se están poniendo al día.
    }
    [many] { $stuck_days } días necesitan ayuda. { $pending_quantity ->
        [one] 1 día más todavía se está poniendo al día.
        [many] { $pending_days } días más todavía se están poniendo al día.
       *[other] { $pending_days } días más todavía se están poniendo al día.
    }
   *[other] { $stuck_days } días necesitan ayuda. { $pending_quantity ->
        [one] 1 día más todavía se está poniendo al día.
        [many] { $pending_days } días más todavía se están poniendo al día.
       *[other] { $pending_days } días más todavía se están poniendo al día.
    }
}

journal.window.system.health.backlog.verdict.pending = { $quantity ->
    [one] 1 día todavía se está poniendo al día.
    [many] { $count } días todavía se están poniendo al día.
   *[other] { $count } días todavía se están poniendo al día.
}

journal.window.system.health.backlog.verdict.stale.day = { $quantity ->
    [one] no está claro si tu diario está al día; la última actualización fue hace 1 día.
    [many] no está claro si tu diario está al día; la última actualización fue hace { $count } días.
   *[other] no está claro si tu diario está al día; la última actualización fue hace { $count } días.
}

journal.window.system.health.backlog.verdict.stale.hour = { $quantity ->
    [one] no está claro si tu diario está al día; la última actualización fue hace 1 hora.
    [many] no está claro si tu diario está al día; la última actualización fue hace { $count } horas.
   *[other] no está claro si tu diario está al día; la última actualización fue hace { $count } horas.
}

journal.window.system.health.backlog.verdict.stale.unknown = sin una hora confiable de su última actualización de estado, tu diario no puede saber si está al día.

journal.window.system.health.backlog.verdict.stuck = { $quantity ->
    [one] al día, excepto 1 día que necesita ayuda.
    [many] al día, excepto { $count } días que necesitan ayuda.
   *[other] al día, excepto { $count } días que necesitan ayuda.
}

journal.window.system.health.backlog.verdict.unclear.now = no está claro si tu diario está al día en este momento.

journal.window.system.health.index.behind.count = { $quantity ->
    [one] la búsqueda se está poniendo al día con 1 cambio en tu diario.
    [many] la búsqueda se está poniendo al día con { $count } cambios en tu diario.
   *[other] la búsqueda se está poniendo al día con { $count } cambios en tu diario.
}

journal.window.system.health.index.building = la búsqueda todavía se está construyendo.

journal.window.system.health.index.catching.up = la búsqueda se está poniendo al día con tu diario.

journal.window.system.health.index.check.overdue = la revisión diaria de la búsqueda no ha terminado desde hace más de dos días, así que pueden faltar algunos cambios en la búsqueda.

journal.window.system.health.index.classification.stalled = la búsqueda dejó de clasificar algunas entradas más antiguas en tus facetas y necesita una reparación.

journal.window.system.health.index.damage.check = la búsqueda encontró un problema en su índice y lo está revisando.

journal.window.system.health.index.failed.deletions = no se pudo sacar de la búsqueda algunas entradas quitadas.

journal.window.system.health.index.failed.files = no se pudo agregar algunas actualizaciones del diario a la búsqueda.

journal.window.system.health.index.newer.generation = una versión más reciente de solstone fue la última en actualizar la búsqueda, así que esta versión no va a agregarle cambios nuevos.

journal.window.system.health.index.ok = la búsqueda está al día con tu diario.

journal.window.system.health.index.queued.unavailable = la búsqueda no puede revisar sus actualizaciones en cola en este momento.

journal.window.system.health.index.repair = la búsqueda dejó de actualizarse y necesita una reparación.

journal.window.system.health.index.repeated.rebuild = la búsqueda tuvo que reconstruirse más de una vez esta semana, lo que puede indicar que el disco está fallando.

journal.window.system.health.index.retained.count = { $quantity ->
    [one] la búsqueda todavía muestra 1 entrada que ya no está en tu diario.
    [many] la búsqueda todavía muestra { $count } entradas que ya no están en tu diario.
   *[other] la búsqueda todavía muestra { $count } entradas que ya no están en tu diario.
}

journal.window.system.health.index.unreadable = la búsqueda no puede leer su índice en este momento.

journal.window.system.health.not.yet.engine = tu diario empieza a ponerse al día una vez que elijas dónde ocurre el razonamiento.

journal.window.system.health.not.yet.engine.byo = tu diario empieza a ponerse al día una vez que tu propio modelo esté configurado.

journal.window.system.health.not.yet.engine.local = tu diario empieza a ponerse al día una vez que el razonamiento local esté configurado.

journal.window.system.health.not.yet.engine.spp = tu diario empieza a ponerse al día una vez que el procesamiento confidencial esté configurado.

journal.window.system.health.not.yet.first.night = vas a ver si tu diario está al día después de su primera noche.

journal.window.system.health.not.yet.search = la búsqueda se pone al día durante la noche.

journal.window.system.health.unfinished.template.many.days = { $slot1 } actividades no pudieron terminar de procesarse. la más antigua: { $slot2 }

journal.window.system.health.unfinished.template.many.one.day = { $slot1 } actividades de { $slot2 } no pudieron terminar de procesarse

journal.window.system.health.unfinished.template.one = una actividad de { $slot1 } no pudo terminar de procesarse
