journal.window.settings.plaud.check.failed = das Starten einer { $provider }-Prüfung ist nicht gelungen. versuch es noch einmal.

journal.window.settings.plaud.check.started = { $provider } wird auf neue Aufnahmen geprüft...

journal.window.settings.plaud.description = deine { $provider }-Aufnahmen kommen als Audio in dein Journal, zu den Zeiten, zu denen sie stattfanden. neue Aufnahmen folgen innerhalb einer Stunde, wenn der stündliche Abgleich an ist.

journal.window.settings.plaud.disconnect.failed = das Trennen von { $provider } ist nicht gelungen. versuch es noch einmal.

journal.window.settings.plaud.disconnect.note = das Trennen stoppt künftige Prüfungen und entfernt deine Anmeldung aus diesem Journal. schon importierte Aufnahmen bleiben in deinem Journal.

journal.window.settings.plaud.disconnected.reconnect = melde dich erneut an, um neue Aufnahmen hereinzuholen; nichts kommt zweimal an.

journal.window.settings.plaud.disconnected.recordings = { $quantity ->
        [one] die 1 Aufnahme von { $provider } bleibt in deinem Journal.
       *[other] die { $count } Aufnahmen von { $provider } bleiben in deinem Journal.
    }

journal.window.settings.plaud.fact.account = Konto

journal.window.settings.plaud.fact.recordings = Aufnahmen

journal.window.settings.plaud.load.failed = das Laden von { $provider } ist nicht gelungen. öffne die Abgleicheinstellungen erneut, um es noch einmal zu versuchen.

journal.window.settings.plaud.recordings.in.journal = { $count } in deinem Journal

journal.window.settings.plaud.recordings.none = noch keine

journal.window.settings.plaud.response.attempt.expired = Zeitüberschreitung bei diesem Anmeldeversuch. starte die Anmeldung erneut.

journal.window.settings.plaud.response.audio.not.ready = eine Aufnahme in { $provider } war noch nicht zum Herunterladen bereit. prüfe später erneut, oder dein Journal wird es erneut versuchen, wenn der stündliche Abgleich an ist.

journal.window.settings.plaud.response.auth = { $provider } akzeptiert diese Anmeldung nicht mehr. melde dich erneut an, um weiterzumachen.

journal.window.settings.plaud.response.busy = dein Journal prüft { $provider } schon. versuch es noch einmal, wenn es fertig ist.

journal.window.settings.plaud.response.callback.invalid = das war nicht die Anmeldeadresse von { $provider }. kopiere die vollständige Adresse aus deiner Browserleiste und versuch es noch einmal.

journal.window.settings.plaud.response.download = das Herunterladen einer Aufnahme von { $provider } ist nicht gelungen. prüfe später erneut, oder dein Journal wird es erneut versuchen, wenn der stündliche Abgleich an ist.

journal.window.settings.plaud.response.not.connected = melde dich mit { $provider } an, bevor du nach Aufnahmen prüfst.

journal.window.settings.plaud.response.signin.denied = { $provider } hat die Anmeldung nicht genehmigt. versuch es noch einmal.

journal.window.settings.plaud.response.signin.unavailable = das Starten der { $provider }-Anmeldung ist gerade nicht gelungen. prüfe deine Internetverbindung und versuch es noch einmal.

journal.window.settings.plaud.response.storage = dein Journal konnte nicht speichern, was von { $provider } kam. prüfe, ob dieser Computer freien Speicherplatz hat.

journal.window.settings.plaud.response.unavailable = { $provider } war nicht erreichbar. prüfe später erneut, oder dein Journal wird es erneut versuchen, wenn der stündliche Abgleich an ist.

journal.window.settings.plaud.signin.cancelled = Anmeldung abgebrochen.

journal.window.settings.plaud.signin.failed = das Abschließen der Anmeldung mit { $provider } ist nicht gelungen. versuch es noch einmal.

journal.window.settings.plaud.signin.paste.empty = füge zuerst die Adresse aus deiner Browserleiste ein.

journal.window.settings.plaud.signin.paste.help = nach der Genehmigung in { $provider } kopiere die vollständige Adresse aus deiner Browserleiste und füge sie hier ein.

journal.window.settings.plaud.signin.paste.placeholder = Adresse aus deiner Browserleiste einfügen

journal.window.settings.plaud.signin.waiting = schließe die Anmeldung mit { $provider } in deinem Browser ab.

journal.window.settings.plaud.state.connected = verbunden

journal.window.settings.plaud.state.signing.in = Anmeldung läuft

