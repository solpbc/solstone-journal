journal.window.thinking.endpoint.model.image.unchecked = { $reason ->
        [unreachable] endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: der endpoint war nicht erreichbar.
        [timeout] endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: es hat nicht rechtzeitig geantwortet.
        [busy] endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: dein Journal war mit anderer Arbeit beschäftigt.
        [key] endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: es hat den Schlüssel nicht akzeptiert.
        [rejected] endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: es hat die Anfrage abgelehnt.
        [unusable] endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: es hat nichts Brauchbares zurückgesendet.
       *[other] endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: da ist etwas schiefgelaufen.
    }

journal.window.thinking.endpoint.model.image.unchecked.legacy = endpoint gespeichert. ob { $model_name } Bilder liest, konnte nicht geprüft werden: { $failure_reason }.

journal.window.thinking.endpoint.model.schema.not.followed = endpoint gespeichert, aber { $model_name } hat nicht in der strukturierten Form geantwortet, die die Verarbeitung verlangt, also scheitert die meiste Verarbeitung. manche Server können das nicht mit jedem Modell: versuch ein anderes Modell oder einen anderen Server und speichere dann erneut.

