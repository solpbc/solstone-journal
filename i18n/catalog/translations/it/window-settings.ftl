journal.window.system.health.backlog.verdict.mixed = { $stuck_quantity ->
    [one] 1 giorno ha bisogno di una mano. { $pending_quantity ->
            [one] 1 giorno in più si sta ancora aggiornando.
            [many] { $pending_days } di giorni in più si stanno ancora aggiornando.
           *[other] { $pending_days } giorni in più si stanno ancora aggiornando.
        }
    [many] { $stuck_days } di giorni hanno bisogno di una mano. { $pending_quantity ->
            [one] 1 giorno in più si sta ancora aggiornando.
            [many] { $pending_days } di giorni in più si stanno ancora aggiornando.
           *[other] { $pending_days } giorni in più si stanno ancora aggiornando.
        }
   *[other] { $stuck_days } giorni hanno bisogno di una mano. { $pending_quantity ->
            [one] 1 giorno in più si sta ancora aggiornando.
            [many] { $pending_days } di giorni in più si stanno ancora aggiornando.
           *[other] { $pending_days } giorni in più si stanno ancora aggiornando.
        }
    }

