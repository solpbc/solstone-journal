{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solstone-journal-format:browser-jsonl",
  "title": "Browser stream JSONL",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "header": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "t",
        "ts"
      ],
      "properties": {
        "t": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "rel": {
          "type": "number"
        },
        "site": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "ctx": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "blocks": {
          "type": "array"
        },
        "op": {
          "type": "string"
        },
        "block": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "t",
        "ts"
      ],
      "properties": {
        "t": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "rel": {
          "type": "number"
        },
        "site": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "ctx": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        },
        "blocks": {
          "type": "array"
        },
        "op": {
          "type": "string"
        },
        "block": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "x-journal-contract": {
    "format_id": "browser-jsonl",
    "schema_owner": "think.browser",
    "reference_writer": "none (external solstone-browser extension via observer ingest)",
    "allowed_producers": [
      "solstone-browser extension via ingest"
    ],
    "write_discipline": "append-only JSONL via observer ingest",
    "file_kind": "headered_jsonl",
    "key_fields": [
      "t",
      "ts",
      "site",
      "op",
      "block",
      "blocks"
    ],
    "producer_write_paths": [
      "chronicle/YYYYMMDD/{host}.browser/HHMMSS_LEN/browser_{host-slug}.jsonl"
    ]
  }
}
