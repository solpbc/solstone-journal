{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solstone-journal-format:audio-jsonl",
  "title": "Audio transcript JSONL",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "header": {
      "type": "object",
      "additionalProperties": true,
      "required": [],
      "properties": {
        "raw": {"type": "string"},
        "observer": {"type": "string"},
        "backend": {"type": "string"},
        "model": {"type": "string"},
        "duration": {"type": "number"},
        "noisy": {"type": "boolean"},
        "topics": {"type": "array"},
        "setting": {"type": "string"},
        "warning": {"type": "string"},
        "imported": {"type": "object", "additionalProperties": true},
        "facet": {"type": "string"},
        "id": {"type": "string"},
        "speaker_evidence": {
          "type": "string",
          "enum": ["single", "multi", "none"],
          "description": "Windowed slot evidence decision from native speaker analysis. This records engagement, not clustering outcome: a multi value with no integer speaker labels means diarization engaged and clustering produced nothing or failed."
        },
        "speaker_evidence_multi_fraction": {
          "type": "number",
          "description": "Fraction of speech-bearing pyannote windows with multi-speaker slot evidence. This records engagement evidence, not clustering outcome."
        },
        "speaker_evidence_version": {
          "type": "string",
          "const": "windowed-slots-v1",
          "description": "Version of the speaker-evidence decision contract, pinned to windowed-slots-v1 so readers can gate interpretation."
        },
        "sound_tags": {
          "type": "object",
          "additionalProperties": true,
          "required": ["engine", "model", "threshold", "window_s", "agg", "windows", "tags"],
          "properties": {
            "engine": {"type": "string"},
            "model": {"type": "string"},
            "threshold": {"type": "number"},
            "window_s": {"type": "number"},
            "agg": {"type": "string"},
            "windows": {"type": "integer"},
            "tags": {
              "type": "object",
              "additionalProperties": {"type": "number"}
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["start", "text"],
      "properties": {
        "start": {"type": "string"},
        "text": {"type": "string"},
        "sentence_id": {"type": "integer"},
        "source": {"type": "string"},
        "speaker": {"type": ["string", "integer"]},
        "corrected": {"type": "string"},
        "emotion": {"type": "string"}
      }
    }
  },
  "x-journal-contract": {
    "format_id": "audio-jsonl",
    "schema_owner": "observe.transcribe",
    "reference_writer": "solstone-core speaker-transcript-write",
    "allowed_producers": ["journal transcriber", "native observers via ingest"],
    "write_discipline": "headered_jsonl atomic whole-file replace",
    "file_kind": "headered_jsonl",
    "key_fields": ["header.raw", "record.start", "record.text", "record.sentence_id", "record.corrected", "record.source", "record.speaker", "record.emotion"],
    "producer_write_paths": ["chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/audio.jsonl"],
    "legacy_read_paths": ["chronicle/YYYYMMDD/{stream}/HHMMSS_LEN/{source}_audio.jsonl"]
  }
}
