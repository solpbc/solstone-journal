{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "thread",
    "view",
    "messages"
  ],
  "properties": {
    "app": {
      "type": "string",
      "maxLength": 64
    },
    "thread": {
      "type": "string",
      "maxLength": 192
    },
    "view": {
      "type": "string",
      "enum": [
        "conversation",
        "inbox",
        "unknown"
      ]
    },
    "messages": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sender",
          "timestamp",
          "subject",
          "text"
        ],
        "properties": {
          "sender": {
            "type": "string",
            "maxLength": 128
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 96
          },
          "subject": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
