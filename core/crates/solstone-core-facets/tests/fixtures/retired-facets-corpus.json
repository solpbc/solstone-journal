{
  "about": "Parse parity for facets/retired.json. Both readers (solstone-core-facets and solstone-core-indexer-store) must reduce each input to exactly these id/successor pairs; a null expected means the input yields no entries.",
  "cases": [
    {
      "input": "{\"names\":{\"sunstone\":{\"state\":\"merged\",\"id\":\"11111111-1111-4111-8111-111111111111\",\"successor\":\"22222222-2222-4222-8222-222222222222\",\"title\":\"Sunstone\",\"at\":\"2026-09-26T00:00:00Z\"}}}",
      "expected": {"sunstone": {"id": "11111111-1111-4111-8111-111111111111", "successor": "22222222-2222-4222-8222-222222222222"}}
    },
    {
      "input": "{\"names\":{\"old\":{\"state\":\"renamed\",\"id\":null,\"successor\":\"22222222-2222-4222-8222-222222222222\"}}}",
      "expected": {"old": {"id": null, "successor": "22222222-2222-4222-8222-222222222222"}}
    },
    {
      "input": "{\"names\":{\"gone\":{\"state\":\"deleted\",\"id\":\"33333333-3333-4333-8333-333333333333\",\"successor\":\"22222222-2222-4222-8222-222222222222\"}}}",
      "expected": {"gone": {"id": "33333333-3333-4333-8333-333333333333", "successor": null}}
    },
    {
      "input": "{\"names\":{\"odd\":{\"state\":\"archived\",\"id\":\"not-a-uuid\",\"successor\":\"22222222-2222-4222-8222-222222222222\"}}}",
      "expected": {"odd": {"id": null, "successor": null}}
    },
    {
      "input": "{\"names\":{\"bad\":{\"state\":\"merged\",\"successor\":\"22222222-2222-4222-8222-22222222222\"},\"skipped\":\"not an object\"}}",
      "expected": {"bad": {"id": null, "successor": null}}
    },
    {"input": "{not json", "expected": null},
    {"input": "[]", "expected": null},
    {"input": "{\"other\":{}}", "expected": null}
  ]
}
