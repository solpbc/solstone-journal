{
  "openapi": "3.1.0",
  "info": {
    "title": "Linked-device client description contract",
    "version": "1.3.0",
    "description": "Linked-device client description and owner labeling contract. Covers GET/PUT /app/network/api/clients/self, PATCH /app/network/api/clients/{cid}/label, and shared source declarations.",
    "x-disclaimer": "reported-device-metadata / owner-label-precedence"
  },
  "paths": {
    "/app/network/api/clients/self": {
      "get": {
        "operationId": "client.getSelfDescription",
        "x-aliases": [
          "/app/link/api/clients/self"
        ],
        "description": "Get current description for the authenticated caller linked device.",
        "responses": {
          "200": {
            "description": "Caller description retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientDescriptionResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an authenticated linked device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "client.putSelfDescription",
        "x-aliases": [
          "/app/link/api/clients/self"
        ],
        "description": "Update reported description for the caller linked device with optimistic concurrency control.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutSelfDescriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Client description updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientDescriptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid description payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an authenticated linked device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision conflict / optimistic concurrency mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/app/network/api/clients/{cid}/label": {
      "patch": {
        "operationId": "client.patchClientLabel",
        "x-aliases": [
          "/app/link/api/clients/{cid}/label"
        ],
        "description": "Set or clear the owner override label for a paired device. Callable from the computer the journal runs on or from any device paired with the journal.",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Client fingerprint (SHA-256 digest)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchClientLabelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Owner label updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatchClientLabelResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid label payload or string validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Owner access required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Paired device not found in authorization ledger",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/app/network/api/clients/self/sources": {
      "put": {
        "description": "Replace the declaring paired device’s source list. The certificate identifies the device.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SourceDeclaration"
                },
                "maxItems": 64,
                "description": "Complete replacement in any order. Each source/detail pair must be unique. An empty array clears the list. Omit off and setting_up sources. When a device has more than 64 active sources, include all non-folder sources first and fill remaining slots with folders ordered by needs_attention, paused, then on, tie-broken by folder_id ascending."
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Saved."
          },
          "400": {
            "description": "Correct the invalid declaration before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "A paired device is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Retry without unpairing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "client.putSelfSources"
      }
    },
    "/app/network/api/sources": {
      "get": {
        "description": "Currently paired devices and their sources. Confirmed declarations take precedence over accepted deliveries. The caller has a null self_cid on localhost.",
        "responses": {
          "200": {
            "description": "Known sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnownSources"
                }
              }
            }
          },
          "403": {
            "description": "Pair this device again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Retry without unpairing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "client.knownSources"
      }
    },
    "/api/system/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Additive source-awareness fields. The token is opaque and null when temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "contains": {
                        "const": "shared_sources"
                      }
                    },
                    "sources_rev": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "capabilities",
                    "sources_rev"
                  ]
                }
              }
            }
          }
        },
        "operationId": "system.sourceCapabilities"
      }
    }
  },
  "components": {
    "schemas": {
      "ReportedDescription": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable device name reported by client",
            "x-max-utf8-bytes": 80
          },
          "platform": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reported operating system platform",
            "x-max-utf8-bytes": 64
          },
          "device_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reported device form factor",
            "x-max-utf8-bytes": 64
          },
          "app_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Client application identifier",
            "x-max-utf8-bytes": 64
          },
          "app_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Client application semver or build version",
            "x-max-utf8-bytes": 64
          }
        },
        "required": [
          "name",
          "platform",
          "device_type",
          "app_id",
          "app_version"
        ]
      },
      "JournalIdentityMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Mark words for this journal, middot-joined, when an identity exists. Null when it does not."
          },
          "version": {
            "type": "string",
            "description": "Server package version"
          }
        }
      },
      "ClientDescriptionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "revision",
          "reported",
          "owner_label",
          "display_label",
          "updated_at",
          "journal"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "reported": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReportedDescription"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_label": {
            "type": "string"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "journal": {
            "$ref": "#/components/schemas/JournalIdentityMeta"
          }
        }
      },
      "PutSelfDescriptionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "expected_revision",
          "reported"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "reported": {
            "$ref": "#/components/schemas/ReportedDescription"
          }
        }
      },
      "PatchClientLabelRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Journal owner override label, or null to clear",
            "x-max-utf8-bytes": 80
          }
        },
        "required": [
          "label"
        ]
      },
      "PatchClientLabelResponse": {
        "$ref": "#/components/schemas/ClientDescriptionResponse"
      },
      "Error": {
        "type": "object",
        "required": [
          "reason_code",
          "detail"
        ],
        "properties": {
          "reason_code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "SourceDeclaration": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nonblank if present, at most 256 UTF-8 bytes, without control characters. For source \"folder\", carries the stable client-assigned folder ID (meta.folder.id), never the display name."
          },
          "state": {
            "type": "string",
            "enum": [
              "on",
              "paused",
              "needs_attention"
            ]
          }
        },
        "required": [
          "source",
          "state"
        ],
        "additionalProperties": false
      },
      "KnownSource": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "on",
                  "paused",
                  "needs_attention"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "enum": [
              "declared",
              "observed"
            ]
          },
          "last_synced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "declared_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "detail",
          "state",
          "origin",
          "last_synced_at",
          "declared_at"
        ]
      },
      "SourceDevice": {
        "type": "object",
        "properties": {
          "cid": {
            "type": "string"
          },
          "display_label": {
            "type": "string"
          },
          "platform": {
            "type": [
              "string",
              "null"
            ]
          },
          "device_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "device_last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KnownSource"
            }
          }
        },
        "required": [
          "cid",
          "display_label",
          "platform",
          "device_type",
          "device_last_seen_at",
          "sources"
        ]
      },
      "KnownSources": {
        "type": "object",
        "properties": {
          "self_cid": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources_rev": {
            "type": "string"
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceDevice"
            }
          }
        },
        "required": [
          "self_cid",
          "sources_rev",
          "devices"
        ]
      }
    }
  }
}
