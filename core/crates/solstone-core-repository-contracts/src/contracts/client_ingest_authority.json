{
  "openapi": "3.1.0",
  "paths": {
    "/app/devices/ingest": {
      "post": {
        "description": "Upload one capture segment from a linked device as multipart form data. Identity is the linked-device mTLS certificate. The body has one JSON `envelope` part plus repeated `files` parts. Envelope grammar is `core/crates/solstone-core/src/contract/schemas/protocol.schema.json` (required `day`, `segment`, `files`; optional `source`, `meta`; `stream` and `observer` are forbidden). Each multipart part is at most 64 MiB; the total request is at most 128 MiB.",
        "operationId": "client.ingestUpload",
        "parameters": [
          {
            "description": "Linked-device ingest protocol version. Must be 3. Values less than 3 are rejected with HTTP 426 Upgrade Required; values greater than 3 are rejected as unsupported. Identity is the linked-device mTLS certificate, not a request header.",
            "in": "header",
            "name": "X-Solstone-Protocol-Version",
            "required": true,
            "schema": {
              "const": 3,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "envelope": {
                    "description": "JSON object. Grammar: core/crates/solstone-core/src/contract/schemas/protocol.schema.json",
                    "format": "json",
                    "type": "string"
                  },
                  "files": {
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "envelope",
                  "files"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "duplicate": {
                    "summary": "Duplicate segment",
                    "value": {
                      "existing_segment": "143000_1",
                      "message": "All files already received",
                      "status": "duplicate",
                      "file_descriptors": [
                        {
                          "disposition": "already_held",
                          "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
                          "size": 524288,
                          "submitted": "audio.m4a",
                          "written": "audio.m4a"
                        }
                      ],
                      "meta": {}
                    }
                  },
                  "normal": {
                    "summary": "New segment accepted",
                    "value": {
                      "bytes": 524288,
                      "files": [
                        "audio.m4a"
                      ],
                      "segment": "143000_1",
                      "status": "ok",
                      "file_descriptors": [
                        {
                          "disposition": "written",
                          "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
                          "size": 524288,
                          "submitted": "audio.m4a",
                          "written": "audio.m4a"
                        }
                      ],
                      "meta": {}
                    }
                  }
                },
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "bytes": {
                      "type": "integer"
                    },
                    "existing_segment": {
                      "type": "string"
                    },
                    "file_descriptors": {
                      "description": "One custody receipt per submitted file, returned only after the journal durably recorded the upload. A device proves custody of a file when its `sha256` and `size` equal the local file's and its `disposition` is `written` or `already_held`; `received_not_written` is never custody.",
                      "items": {
                        "$ref": "#/components/schemas/FileDescriptor"
                      },
                      "type": "array"
                    },
                    "files": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "message": {
                      "type": "string"
                    },
                    "meta": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "segment": {
                      "type": "string"
                    },
                    "segment_original": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "duplicate",
                        "collision",
                        "failed"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Upload accepted, collision-adjusted, or duplicate."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Upload request failed validation.",
            "x-reason-codes": [
              "protocol_version_required",
              "protocol_version_malformed",
              "field_missing",
              "envelope_invalid",
              "day_invalid",
              "segment_invalid",
              "multipart_malformed",
              "multipart_part_too_large",
              "browser_record_invalid",
              "calendar_note_invalid",
              "obsidian_note_invalid",
              "screenshot_invalid"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A linked-device identity is required.",
            "x-reason-codes": [
              "linked_device_required"
            ]
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Held sidecar bytes conflict, the device's stream binding is refused, or a note window or screenshot is later than the journal's today (held on the device and sent again later).",
            "x-reason-codes": [
              "content_conflict",
              "pairing_identity_unavailable",
              "foreign_stream_binding",
              "malformed_evidence_row",
              "obsidian_note_ahead",
              "screenshot_ahead"
            ]
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Request exceeds the 128 MiB total-body limit."
          },
          "426": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Protocol version is not 3.",
            "x-reason-codes": [
              "protocol_version_legacy",
              "protocol_version_future"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Journal write or notification failed, or the owner removed the requested segment (`reason_code: segment_removed`, body `status: failed`). A device that knows `segment_removed` stops re-sending that segment.",
            "x-reason-codes": [
              "segment_removed"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The journal can't take this upload right now (body `status: retryable`). Hold it and send it again later."
          }
        },
        "summary": "Upload one capture segment from a linked device",
        "tags": [
          "client"
        ],
        "x-sources": {
          "screenshots": {
            "description": "A screenshot the owner took, sent by the solstone app on the device that holds it. One upload carries one screenshot. It lands at its capture second in the sending device's screenshots stream, is made searchable the way a screen is, and is kept once across the owner's devices.",
            "source": "screenshots",
            "capability": "screenshots",
            "capability_rule": "Send only to a journal whose `GET /api/system/status` lists `screenshots` in `capabilities`. Below that, hold every screenshot on the device and send it once the paired journal lists it.",
            "files": "Exactly one file per upload, named `screenshot_screen.<extension>` with an accepted extension in lowercase. No other file goes with it, and that name is refused under any other source.",
            "accepted_types": [
              {
                "extension": "png",
                "media_type": "image/png"
              },
              {
                "extension": "jpg",
                "media_type": "image/jpeg"
              },
              {
                "extension": "jpeg",
                "media_type": "image/jpeg"
              },
              {
                "extension": "webp",
                "media_type": "image/webp"
              }
            ],
            "accepted_types_rule": "The bytes must be the type the extension names. The journal accepts png, jpg, jpeg and webp, and refuses HEIC, HEIF, TIFF, GIF, PDF and every other type because it can't decode them. Send an accepted type exactly as the platform saved it. A type outside those is converted to PNG on the device, keeping its metadata, and sent as png.",
            "size_limit": {
              "max_bytes": 67108864,
              "max_pixels": 100000000,
              "rule": "At most 64 MiB, the part limit for every upload (larger is refused with `multipart_part_too_large`), and at most 100,000,000 pixels by the image's own header (larger is refused with `screenshot_invalid`)."
            },
            "identity": "A screenshot is the SHA-256 of its exact bytes, computed by the journal; the device sends no id. Send an accepted type exactly as the platform saved it: do not re-encode, resize, crop, rotate or strip its metadata. A type outside png, jpg, jpeg and webp is converted to PNG on the device, keeping its metadata, and then the identity is the hash of that PNG. The same bytes from a second device, or sent again after a re-scan, a turn-back-on or a re-pair, are the same screenshot and are answered `duplicate`.",
            "capture_time": "`meta.screenshot.captured_at` is the moment it was taken, RFC 3339 with the UTC offset in force where it was taken (`Z` means `+00:00`). It comes from the platform's own record of the screenshot or from the file (its embedded date or modification time), never from a model, and `meta.screenshot.taken_from` says which (`platform` or `file`). The envelope's `day` (`YYYYMMDD`) and `segment` (`HHMMSS_1`) are that moment's date and clock time in its own offset, so the screenshot lands at the minute it was taken.",
            "device": "The device is the linked device that sends the upload, by its mTLS identity; no field names it. The screenshot lands in that device's screenshots stream and is labelled with the device's name as the journal shows it. A screenshot already received from another device keeps the label of the device that sent it first.",
            "meta_schema": {
              "type": "object",
              "required": [
                "screenshot"
              ],
              "properties": {
                "screenshot": {
                  "type": "object",
                  "required": [
                    "v",
                    "captured_at",
                    "taken_from"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "v": {
                      "const": 1
                    },
                    "captured_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "taken_from": {
                      "enum": [
                        "platform",
                        "file"
                      ]
                    }
                  }
                }
              }
            },
            "deleted": "The journal remembers every screenshot this source has received, and that memory outlives a delete. A screenshot the owner deleted from the journal is answered `duplicate` when a device sends it again, from any device and after any re-scan. The owner bringing the same file in through the Import page or a share is a re-import and arrives as new data; that path is not this source.",
            "answers": [
              {
                "http_status": 200,
                "status": "ok",
                "meaning": "Kept, at the requested segment.",
                "client_action": "Mark it delivered and never send it again. It counts toward the in-your-journal total."
              },
              {
                "http_status": 200,
                "status": "collision",
                "meaning": "Kept, at a nearby segment because the requested one was taken (`segment` names it).",
                "client_action": "As `ok`."
              },
              {
                "http_status": 200,
                "status": "duplicate",
                "meaning": "Already in this journal, from this device or another, or received before and since deleted by the owner.",
                "client_action": "Mark it delivered and never send it again. It counts toward the in-your-journal total."
              },
              {
                "http_status": 400,
                "reason_code": "screenshot_invalid",
                "meaning": "The upload breaks this contract, or the image can't be read: wrong name or type, bytes that aren't the named type, over the pixel limit, missing or inconsistent `meta.screenshot`.",
                "client_action": "Don't send it again. It reaches its final state on the device: counted, with the string that says it couldn't come in."
              },
              {
                "http_status": 400,
                "reason_code": "multipart_part_too_large",
                "meaning": "Over 64 MiB.",
                "client_action": "As `screenshot_invalid`."
              },
              {
                "http_status": 409,
                "reason_code": "screenshot_ahead",
                "meaning": "Its day is later than the journal's today.",
                "client_action": "Hold it and send it again once the journal's day has reached it."
              },
              {
                "http_status": 503,
                "status": "retryable",
                "meaning": "The journal can't take it right now, including when it can't read what this source has received.",
                "client_action": "Hold it and send it again later, with backoff."
              },
              {
                "http_status": 500,
                "status": "failed",
                "meaning": "The journal couldn't finish the write.",
                "client_action": "Hold it and send it again later, with backoff. A resend of the same bytes is never kept twice."
              },
              {
                "http_status": "403, 409 (stream binding), 426",
                "meaning": "The linked-device and protocol answers every upload shares.",
                "client_action": "As for every other source: hold it and follow the pairing contract."
              }
            ],
            "golden": [
              {
                "day": "20261103",
                "segment": "143207_1",
                "source": "screenshots",
                "files": [
                  {
                    "submitted": "screenshot_screen.png"
                  }
                ],
                "meta": {
                  "screenshot": {
                    "v": 1,
                    "captured_at": "2026-11-03T14:32:07-07:00",
                    "taken_from": "platform"
                  }
                }
              },
              {
                "day": "20261104",
                "segment": "091502_1",
                "source": "screenshots",
                "files": [
                  {
                    "submitted": "screenshot_screen.jpg"
                  }
                ],
                "meta": {
                  "screenshot": {
                    "v": 1,
                    "captured_at": "2026-11-04T09:15:02+01:00",
                    "taken_from": "file"
                  }
                }
              },
              {
                "day": "20261105",
                "segment": "000000_1",
                "source": "screenshots",
                "files": [
                  {
                    "submitted": "screenshot_screen.webp"
                  }
                ],
                "meta": {
                  "screenshot": {
                    "v": 1,
                    "captured_at": "2026-11-05T00:00:00Z",
                    "taken_from": "platform"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "/app/devices/ingest/segments/{day}": {
      "get": {
        "description": "Return segment upload history for one day as a protocol-version-3 collection envelope. The physical locator is the day, stream directory, and exact segment-directory basename. `key` is that basename unless this response repeats the basename; repeated basenames use `{basename}~{stream}`, then `~2`, `~3`, and so on, and those items also carry `segment` (the directory basename) and `stream`. `original_key` records only an upload remap of the requested key and does not identify a stream. A within-segment effective-name clash remains `ambiguous_segment_file_name`. Per-file `status` is `present`, `processed`, or `missing`. `submitted_name` appears only when the stored filename differs from the submitted one.",
        "operationId": "client.ingestSegments",
        "parameters": [
          {
            "description": "Linked-device ingest protocol version. Must be 3. Values less than 3 are rejected with HTTP 426 Upgrade Required; values greater than 3 are rejected as unsupported. Identity is the linked-device mTLS certificate, not a request header.",
            "in": "header",
            "name": "X-Solstone-Protocol-Version",
            "required": true,
            "schema": {
              "const": 3,
              "type": "integer"
            }
          },
          {
            "description": "YYYYMMDD day.",
            "in": "path",
            "name": "day",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional device-chosen sub-stream discriminator.",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "items": [
                    {
                      "files": [
                        {
                          "name": "audio.m4a",
                          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                          "size": 4096,
                          "status": "present"
                        }
                      ],
                      "key": "143000"
                    }
                  ],
                  "protocol_version": 3,
                  "total": 1
                },
                "schema": {
                  "$ref": "#/components/schemas/SegmentsEnvelope"
                }
              }
            },
            "description": "Segment verification response."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Day path parameter or protocol version was invalid.",
            "x-reason-codes": [
              "day_invalid",
              "protocol_version_required",
              "protocol_version_malformed"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A linked-device identity is required.",
            "x-reason-codes": [
              "linked_device_required"
            ]
          },
          "426": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Protocol version is not 3.",
            "x-reason-codes": [
              "protocol_version_legacy",
              "protocol_version_future"
            ]
          }
        },
        "summary": "List uploaded linked-device segments",
        "tags": [
          "client"
        ]
      }
    },
    "/app/devices/ingest/obsidian/vaults": {
      "get": {
        "description": "List the Obsidian vaults this journal has from devices other than the caller, so an app can warn before the first send of a vault with the same name. `device` is the device's label as the journal knows it, or null.",
        "operationId": "client.ingestObsidianVaults",
        "parameters": [
          {
            "description": "Linked-device ingest protocol version. Must be 3.",
            "in": "header",
            "name": "X-Solstone-Protocol-Version",
            "required": true,
            "schema": {
              "const": 3,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "vaults": [
                    {
                      "device": "studio",
                      "last_synced_at": "2026-11-08T09:44:33-07:00",
                      "vault": "Notes"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ObsidianVaultsEnvelope"
                }
              }
            },
            "description": "Vaults known from other devices."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The caller is not a linked device."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The vault list could not be read."
          }
        },
        "summary": "List Obsidian vaults held from other devices"
      }
    }
  },
