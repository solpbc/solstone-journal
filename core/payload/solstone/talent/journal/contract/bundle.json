    },
    "observer-ingest-envelope": {
      "schema": {
        "$id": "solstone-journal-format:observer-ingest-envelope",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": true,
        "properties": {
          "day": {
            "description": "Device-local wall-clock calendar day (YYYYMMDD) on the observing device at capture start; not normalized to UTC.",
            "pattern": "^\\d{8}$",
            "type": "string"
          },
          "files": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "submitted": {
                  "type": "string"
                }
              },
              "required": [
                "submitted"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object"
          },
          "segment": {
            "description": "Device-local wall-clock capture window keyed HHMMSS_LEN: HHMMSS is the wall-clock start time on the observing device; LEN is the real captured whole-second media duration, stamped when the capture window finishes. LEN is bounded by the segment rotation ceiling (300 seconds standard) and, after crash recovery, never exceeds the real media duration. These bounds are descriptive; the envelope grammar does not enforce them.",
            "pattern": "^\\d{6}_\\d+$",
            "type": "string"
          },
          "source": {
            "description": "Optional device-chosen sub-stream discriminator; omitted or empty selects the primary capture. Not identity and authenticates nothing. At most 64 bytes; nonempty values match [a-z0-9][a-z0-9_-]* and must not contain NUL, '.', '/', or '\\'.",
            "maxLength": 64,
            "pattern": "^([a-z0-9][a-z0-9_-]*)?$",
            "type": "string"
          }
        },
        "propertyNames": {
          "not": {
            "enum": [
              "stream",
              "observer"
            ]
          }
        },
        "required": [
          "day",
          "segment",
          "files"
        ],
        "title": "Observer ingest envelope",
        "type": "object",
        "x-journal-contract": {
          "allowed_producers": [
            "native observers",
            "solstone observe transfer"
          ],
          "file_kind": "ingest_envelope",
          "format_id": "observer-ingest-envelope",
          "key_fields": [
            "day",
            "segment",
            "source",
            "files[].submitted"
          ],
          "key_semantics": {
            "day": "YYYYMMDD device-local calendar day at capture start",
            "observer": "legacy envelope field; presence is refused",
            "segment": "HHMMSS_LEN; HHMMSS device-local wall-clock start",
            "segment_len": "real captured whole-second media duration; stamped at capture finish; bounded by the segment rotation ceiling (300 seconds standard); crash-recovered LEN <= real media duration; descriptive only, not grammar-enforced",
            "source": "optional device-chosen sub-stream discriminator, empty for the primary capture; not identity; authenticates nothing; selects within an already-authenticated device's own namespace",
            "stream": "legacy envelope field; presence is refused",
            "timezone": "device-local wall-clock; not UTC-normalized"
          },
          "producer_write_paths": [
            "POST /app/devices/ingest"
          ],
          "protocol_version": 3,
          "reference_writer": "solstone-core-ingest",
          "schema_owner": "solstone-core-ingest",
          "write_discipline": "multipart envelope validated before segment write"
        }
      },
      "source": "core/crates/solstone-core/src/contract/schemas/protocol.schema.json"
    },
    "observer-ingest-json": {
      "schema": {
        "$id": "solstone-journal-format:observer-ingest-json",
