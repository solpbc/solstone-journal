+bool parse_positive_size(const std::string& text, size_t& out) {
+    if (text.empty()) return false;
+    char* end = nullptr;
+    errno = 0;
+    const unsigned long long parsed = std::strtoull(text.c_str(), &end, 10);
+    if (errno != 0 || end == text.c_str() || *end != '\0' || parsed == 0 ||
+        parsed > std::numeric_limits<size_t>::max()) {
+        return false;
+    }
+    out = static_cast<size_t>(parsed);
+    return true;
+}
+
+bool parse_port(const std::string& text, int& out) {
+    size_t parsed = 0;
+    if (!parse_positive_size(text, parsed) || parsed > 65535) return false;
+    out = static_cast<int>(parsed);
+    return true;
+}
+
+bool constant_time_equal(const std::string& left, const std::string& right) {
+    size_t difference = left.size() ^ right.size();
+    const size_t largest = left.size() > right.size() ? left.size() : right.size();
+    for (size_t index = 0; index < largest; ++index) {
+        const unsigned char left_byte =
+            index < left.size() ? static_cast<unsigned char>(left[index]) : 0;
+        const unsigned char right_byte =
+            index < right.size() ? static_cast<unsigned char>(right[index]) : 0;
+        difference |= static_cast<size_t>(left_byte ^ right_byte);
+    }
+    return difference == 0;
+}
+
+bool request_is_authenticated(const httplib::Request& request,
+                              const std::string& token,
+                              const std::string& nonce) {
+    return constant_time_equal(request.get_header_value("Authorization"), "Bearer " + token) &&
+           constant_time_equal(request.get_header_value("X-Solstone-Nonce"), nonce);
+}
+
+// A completed inference cannot be safely interrupted inside ggml. The process
+// owner therefore treats deadline expiry as a fail-closed provider crash; its
+// Windows Job owner observes, reaps, and may restart the whole provider.
+class RequestDeadline {
+public:
+    explicit RequestDeadline(std::chrono::milliseconds duration)
+        : watcher_([this, duration] {
+              std::unique_lock<std::mutex> lock(mutex_);
+              if (!finished_.wait_for(lock, duration, [this] { return complete_; })) {
+                  std::fputs("parakeet-server: request deadline exceeded\n", stderr);
+                  std::fflush(stderr);
+                  std::_Exit(124);
+              }
+          }) {}
+
+    ~RequestDeadline() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            complete_ = true;
+        }
+        finished_.notify_one();
+        watcher_.join();
+    }
+
+    RequestDeadline(const RequestDeadline&) = delete;
+    RequestDeadline& operator=(const RequestDeadline&) = delete;
+
+private:
+    std::mutex mutex_;
+    std::condition_variable finished_;
+    bool complete_ = false;
+    std::thread watcher_;
+};
