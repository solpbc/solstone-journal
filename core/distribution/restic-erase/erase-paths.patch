+package repository
+
+// Targeted removal of unreferenced blobs: rewrite only the pack files that
+// physically hold the named blobs, keep every blob still referenced, then
+// delete the originals and prove by a physical scan that none remains.
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/restic/restic/internal/backend"
+	"github.com/restic/restic/internal/restic"
+	"github.com/restic/restic/internal/ui/progress"
+	"golang.org/x/sync/errgroup"
+)
+
+// BlobOccurrence is one physical copy of a named blob in a pack file.
+type BlobOccurrence struct {
+	PackID restic.ID         `json:"pack_id"`
+	Blob   restic.BlobHandle `json:"blob"`
+}
+
+// BlobScan is what a physical scan of pack files found.
+type BlobScan struct {
+	PacksListed   int              `json:"packs_listed"`
+	PacksRead     int              `json:"packs_read"`
+	Occurrences   []BlobOccurrence `json:"occurrences"`
+	MatchingPacks int              `json:"matching_packs"`
+	selected      map[restic.ID][]restic.Blob
+	physical      restic.IDSet
+}
+
+// ScanBlobs lists the pack files the backend actually holds and authenticates
+// the header of every one, reporting each copy of a blob in targets. It never
+// trusts the index for what a pack contains. When candidates is not nil, only
+// packs in candidates and packs the index doesn't know are read.
+func ScanBlobs(ctx context.Context, repo *Repository, targets restic.BlobSet, candidates restic.IDSet) (BlobScan, error) {
+	result := BlobScan{Occurrences: []BlobOccurrence{}, selected: map[restic.ID][]restic.Blob{}, physical: restic.NewIDSet()}
+	var indexed restic.IDSet
+	if candidates != nil {
+		indexed = repo.idx.Packs(nil)
+	}
+	type packInfo struct {
+		id   restic.ID
+		size int64
+	}
+	var mu sync.Mutex
+	queue := make(chan packInfo)
+	group, groupCtx := errgroup.WithContext(ctx)
+	group.Go(func() error {
+		defer close(queue)
+		return repo.be.List(groupCtx, restic.PackFile, func(fi backend.FileInfo) error {
+			id, err := restic.ParseID(fi.Name)
+			if err != nil {
+				return fmt.Errorf("unparseable pack file name %q: %w", fi.Name, err)
+			}
+			mu.Lock()
+			result.physical.Insert(id)
+			result.PacksListed++
+			mu.Unlock()
+			if candidates != nil && indexed.Has(id) && !candidates.Has(id) {
+				return nil
+			}
+			select {
+			case queue <- packInfo{id, fi.Size}:
+				return nil
+			case <-groupCtx.Done():
+				return groupCtx.Err()
+			}
+		})
+	})
+	for range repo.Connections() {
+		group.Go(func() error {
+			for item := range queue {
+				entries, _, err := repo.ListPack(groupCtx, item.id, item.size)
+				if err != nil {
+					return fmt.Errorf("pack %s header: %w", item.id, err)
+				}
+				var hits []BlobOccurrence
+				for _, entry := range entries {
+					if targets.Has(entry.BlobHandle) {
+						hits = append(hits, BlobOccurrence{item.id, entry.BlobHandle})
+					}
+				}
+				mu.Lock()
+				result.PacksRead++
+				if len(hits) > 0 {
+					result.MatchingPacks++
+					result.selected[item.id] = entries
+					result.Occurrences = append(result.Occurrences, hits...)
+				}
+				mu.Unlock()
+			}
+			return nil
+		})
+	}
+	if err := group.Wait(); err != nil {
+		return result, err
+	}
+	sort.Slice(result.Occurrences, func(i, j int) bool {
+		a, b := result.Occurrences[i], result.Occurrences[j]
+		if a.PackID != b.PackID {
+			return a.PackID.String() < b.PackID.String()
+		}
+		return a.Blob.String() < b.Blob.String()
+	})
+	return result, nil
+}
+
+// RemoveBlobsStats reports what RemoveUnreferencedBlobs did.
+type RemoveBlobsStats struct {
+	Before          BlobScan  `json:"before"`
+	After           *BlobScan `json:"after,omitempty"`
+	BlobsCopied     int       `json:"blobs_copied"`
+	BytesCopied     uint64    `json:"bytes_copied"`
+	PacksRewritten  int       `json:"packs_rewritten"`
+	PacksDeleteOnly int       `json:"packs_deleted_without_rewrite"`
+	PacksDeleted    int       `json:"packs_deleted"`
+}
+
+// RemoveUnreferencedBlobs physically removes every copy of targets from the
+// repository. The caller holds an exclusive lock, and used holds every blob any
+// snapshot still references; a target in used is refused. Only pack files that
+// hold a target are touched: the referenced blobs they also hold are written to
+// new packs first, then the index is rewritten without the old packs, then the
+// old packs are deleted, as prune orders it, so a stop at any point leaves a
+// healthy repository and a rerun finishes the job. Unlike prune, a failed
+// delete is an error. Ends with a physical scan of every pack file.
+func RemoveUnreferencedBlobs(ctx context.Context, repo *Repository, targets restic.BlobSet, used restic.FindBlobSet, printer progress.Printer) (RemoveBlobsStats, error) {
+	var stats RemoveBlobsStats
+	for bh := range targets {
+		if used.Has(bh) {
+			return stats, fmt.Errorf("blob %v is still referenced", bh)
+		}
+	}
+	candidates := restic.NewIDSet()
+	for bh := range targets {
+		for _, pb := range repo.LookupBlob(bh.Type, bh.ID) {
+			candidates.Insert(pb.PackID)
+		}
+	}
+	before, err := ScanBlobs(ctx, repo, targets, candidates)
+	stats.Before = before
+	if err != nil {
+		return stats, err
+	}
+	selected := restic.NewIDSet()
+	for id := range before.selected {
+		selected.Insert(id)
+	}
+	// A referenced blob that also has a copy in a pack this run keeps needs no
+	// copy; otherwise copy it once, from the authenticated header entries.
+	keep := restic.NewBlobSet()
+	jobs := map[restic.ID][]restic.Blob{}
+	for id, entries := range before.selected {
+		for _, entry := range entries {
+			if !used.Has(entry.BlobHandle) || keep.Has(entry.BlobHandle) {
+				continue
+			}
+			elsewhere := false
+			for _, pb := range repo.LookupBlob(entry.Type, entry.ID) {
+				if before.physical.Has(pb.PackID) && !selected.Has(pb.PackID) {
+					elsewhere = true
+					break
+				}
+			}
+			if elsewhere {
+				continue
+			}
+			keep.Insert(entry.BlobHandle)
+			jobs[id] = append(jobs[id], entry)
+			stats.BytesCopied += uint64(entry.Length)
+		}
+	}
+	stats.BlobsCopied = keep.Len()
+	stats.PacksRewritten = len(jobs)
+	stats.PacksDeleteOnly = len(selected) - len(jobs)
+	if len(selected) > 0 {
+		if len(jobs) > 0 {
+			err = repo.WithBlobUploader(ctx, func(ctx context.Context, uploader restic.BlobSaverWithAsync) error {
+				var mu sync.Mutex
+				for id, entries := range jobs {
+					if err := repo.LoadBlobsFromPack(ctx, id, entries, func(bh restic.BlobHandle, buf []byte, err error) error {
+						if err != nil {
+							return err
+						}
+						if _, _, _, err := uploader.SaveBlob(ctx, bh.Type, buf, bh.ID, true); err != nil {
+							return err
+						}
+						mu.Lock()
+						keep.Delete(bh)
+						mu.Unlock()
+						return nil
+					}); err != nil {
+						return err
+					}
+				}
+				return nil
+			})
+			if err != nil {
+				return stats, err
+			}
+			if keep.Len() != 0 {
+				return stats, fmt.Errorf("%d referenced blobs were not copied", keep.Len())
+			}
+		}
+		if err = rewriteIndexFiles(ctx, repo, selected, nil, nil, printer); err != nil {
+			return stats, err
+		}
+		if err = deleteFiles(ctx, false, &internalRepository{repo}, selected, restic.PackFile, printer); err != nil {
+			return stats, fmt.Errorf("deleting pack files: %w", err)
+		}
+		repo.clearIndex()
+		stats.PacksDeleted = len(selected)
+	}
+	after, err := ScanBlobs(ctx, repo, targets, nil)
+	stats.After = &after
+	if err != nil {
+		return stats, err
+	}
+	if len(after.Occurrences) > 0 {
+		return stats, fmt.Errorf("%d copies remain after the delete", len(after.Occurrences))
+	}
+	return stats, nil
+}
