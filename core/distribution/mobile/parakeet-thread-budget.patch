+extern "C" int parakeet_capi_set_threads(int n_threads) {
+    g_load_error.clear();
+    try {
+        pk::set_num_threads(n_threads);
+        pk::global_backend();
+        return pk::backend_thread_count();
+    } catch (const std::exception& e) {
+        g_load_error = e.what();
+        return 0;
+    } catch (...) {
+        g_load_error = "unknown thread-budget error";
+        return 0;
+    }
+}
+
+extern "C" int parakeet_capi_get_threads(void) {
+    g_load_error.clear();
+    try {
+        pk::global_backend();
+        return pk::backend_thread_count();
+    } catch (const std::exception& e) {
+        g_load_error = e.what();
+        return 0;
+    } catch (...) {
+        g_load_error = "unknown thread-budget error";
+        return 0;
+    }
+}
