+
+// Apply changes between complete calls. Synchronizing here also restores the
+// default on clear without disturbing a run_graph per-call scoped setting when
+// it recursively asks global_backend() to realize weights.
+void set_num_threads(int n) {
+    std::lock_guard<std::recursive_mutex> lock(g_backend_mutex);
+    g_num_threads.store(n < 0 ? 0 : n, std::memory_order_relaxed);
+    if (g_backend) {
+        const int threads = effective_threads();
+        g_backend->set_n_threads(threads);
+        g_backend_threads = threads;
+    }
 }
 
