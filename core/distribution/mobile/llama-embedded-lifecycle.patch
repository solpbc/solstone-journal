+
+// App embedding owns backend/session/HTTP lifetimes. Reuse the maintained
+// instance routes and model setup; never install signals, resolve/download a
+// model, or bind the CLI process-global shutdown_handler.
+int llama_server_embedded(common_params & params, server_embedded_control & control) {
+    if (control.cancelled.load()) { return 0; }
+    common_init();
+    llama_backend_init();
+    struct backend_lifetime {
+        ~backend_lifetime() { llama_backend_free(); }
+    } backend;
+    if (!server_prepare_params(params, SERVER_ROLE_INSTANCE)) { return 1; }
+
+    server_stream_session_manager_start();
+    struct session_lifetime {
+        ~session_lifetime() { server_stream_session_manager_stop(); }
+    } sessions;
+    server_mcp mcp_mgr;
+    server_context ctx_server;
+    ctx_server.set_progress_callback(control.on_progress);
+    server_routes routes(params, ctx_server);
+    server_tools tools;
+    server_http_context ctx_http;
+    // Declared last: revoke/join every callback and HTTP worker before model,
+    // route and backend destruction, including exceptions and partial startup.
+    struct instance_lifetime {
+        server_embedded_control & control;
+        server_http_context & http;
+        server_context & ctx;
+        server_mcp & mcp;
+        ~instance_lifetime() {
+            control.clear_stop();
+            http.is_ready.store(false);
+            http.stop();
+            ctx.cancel_pending_responses();
+            ctx.terminate();
+            server_stream_session_manager_stop();
+            mcp.shutdown();
+            http.join();
+        }
+    } lifetime{control, ctx_http, ctx_server, mcp_mgr};
+
+    if (!ctx_http.init(params, true)) { return 1; }
+    server_register_routes(ctx_http, routes);
+    server_register_stream_routes(ctx_http, server_stream_make_get_handler(),
+        server_stream_make_lookup_handler(), server_stream_make_delete_handler());
+    if (!server_setup_features(ctx_http, params, mcp_mgr, tools, SERVER_ROLE_INSTANCE)) { return 1; }
+    control.bind_stop([&] {
+        ctx_http.is_ready.store(false);
+        ctx_http.stop();
+        ctx_server.cancel_pending_responses();
+        ctx_server.terminate();
+    });
+    if (control.cancelled.load()) { return 0; }
+    if (!ctx_http.start()) { return control.cancelled.load() ? 0 : 1; }
+    if (control.cancelled.load()) { return 0; }
+    params.load_progress_callback = [](float, void * data) {
+        return !static_cast<server_embedded_control *>(data)->cancelled.load();
+    };
+    params.load_progress_callback_user_data = &control;
+    if (!ctx_server.load_model(params)) { return control.cancelled.load() ? 0 : 1; }
+    if (control.cancelled.load()) { return 0; }
+    llama_set_abort_callback(ctx_server.get_llama_context(), [](void * data) {
+        auto * control = static_cast<server_embedded_control *>(data);
+        return control->use_compute_abort && control->cancelled.load();
+    }, &control);
+    routes.update_meta(ctx_server);
+    if (!control.publish_ready(ctx_http.port, ctx_http.is_ready)) { return 0; }
+    if (!control.cancelled.load()) { ctx_server.start_loop(); }
+    return 0;
+}
