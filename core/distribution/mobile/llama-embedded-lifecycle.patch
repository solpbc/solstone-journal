diff --git a/tools/server/server-embedded.h b/tools/server/server-embedded.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-embedded.h
@@ -0,0 +1,86 @@
+#pragma once
+#include <atomic>
+#include <functional>
+#include <mutex>
+#include <cstdint>
+#include <optional>
+
+// Private embedding diagnostics. No request text, token IDs, credentials or
+// paths can enter this carrier. Durations are native wall intervals, not CPU.
+enum class server_embedded_phase { admitted, prefill, decode, completed, cancelled, released, loop_exit };
+struct server_embedded_progress {
+    server_embedded_phase phase;
+    int64_t task = -1;
+    int32_t slot = -1;
+    uint64_t prompt_total = 0;
+    std::optional<uint64_t> prompt_cached;
+    std::optional<uint64_t> prompt_processed;
+    uint64_t generated = 0;
+    int32_t output_limit = -1;
+    bool prefill_complete = false;
+    bool terminal = false;
+    std::optional<double> elapsed_ms;
+    std::optional<double> prefill_ms;
+    std::optional<double> decode_ms;
+};
+
+// Owned by one server slot and touched only by its server-loop thread. Progress
+// is rate-limited; every task gets one terminal observation even inside3s.
+struct server_embedded_progress_reporter {
+    std::function<void(const server_embedded_progress &)> callback;
+    int64_t last_task = -1;
+    int64_t last_us = -1;
+    bool terminal_seen = false;
+    void report(const server_embedded_progress & value, int64_t now_us) noexcept {
+        if (!callback) return;
+        if (last_task != value.task) {
+            last_task = value.task;
+            last_us = -1;
+            terminal_seen = false;
+        }
+        if (terminal_seen || (!value.terminal && last_us >= 0 && now_us - last_us < 3000000)) return;
+        last_us = now_us;
+        terminal_seen = value.terminal;
+        // Diagnostics must not fail or unwind inference, including a sink OOM.
+        try { callback(value); } catch (...) {}
+    }
+};
+
+struct common_params;
+
+// One app-owned generation. Never share this control with the CLI entry points.
+struct server_embedded_control {
+    std::atomic<bool> cancelled{false};
+    // The host regression disables CPU-only abort to exercise a quiet loop exit,
+    // matching backends where llama's abort callback is not implemented.
+    bool use_compute_abort = true;
+    std::function<void(int)> on_ready;
+    std::function<void(const server_embedded_progress &)> on_progress;
+
+    void request_stop() {
+        cancelled.store(true);
+        std::lock_guard<std::mutex> lock(mutex);
+        if (stop) { stop(); }
+    }
+    void bind_stop(std::function<void()> fn) {
+        std::lock_guard<std::mutex> lock(mutex);
+        stop = std::move(fn);
+        if (cancelled.load()) { stop(); }
+    }
+    bool publish_ready(int port, std::atomic<bool> & http_ready) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (cancelled.load()) { return false; }
+        http_ready.store(true);
+        if (on_ready) { on_ready(port); }
+        return true;
+    }
+    void clear_stop() {
+        std::lock_guard<std::mutex> lock(mutex);
+        stop = nullptr;
+    }
+private:
+    std::mutex mutex;
+    std::function<void()> stop;
+};
+
+int llama_server_embedded(common_params & params, server_embedded_control & control);
