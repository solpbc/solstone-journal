    "/app/devices/ingest": {
      "post": {
        "description": "Upload one capture segment from a linked device as multipart form data. Identity is the linked-device mTLS certificate. The body has one JSON `envelope` part plus repeated `files` parts. Envelope grammar is `core/crates/solstone-core/src/contract/schemas/protocol.schema.json` (required `day`, `segment`, `files`; optional `source`, `meta`; `stream` and `observer` are forbidden). Each multipart part is at most 64 MiB; the total request is at most 128 MiB.",
        "operationId": "client.ingestUpload",
        "parameters": [
          {
            "description": "Linked-device ingest protocol version. Must be 3. Values less than 3 are rejected with HTTP 426 Upgrade Required; values greater than 3 are rejected as unsupported. Identity is the linked-device mTLS certificate, not a request header.",
            "in": "header",
            "name": "X-Solstone-Protocol-Version",
            "required": true,
            "schema": {
              "const": 3,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "envelope": {
                    "description": "JSON object. Grammar: core/crates/solstone-core/src/contract/schemas/protocol.schema.json",
                    "format": "json",
                    "type": "string"
                  },
                  "files": {
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "envelope",
                  "files"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "duplicate": {
                    "summary": "Duplicate segment",
                    "value": {
                      "existing_segment": "143000_1",
                      "message": "All files already received",
                      "status": "duplicate"
                    }
                  },
                  "normal": {
                    "summary": "New segment accepted",
                    "value": {
                      "bytes": 524288,
                      "files": [
                        "audio.m4a"
                      ],
                      "segment": "143000_1",
                      "status": "ok"
                    }
                  }
                },
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "bytes": {
                      "type": "integer"
                    },
                    "existing_segment": {
                      "type": "string"
                    },
                    "file_descriptors": {
                      "type": "array"
                    },
                    "files": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "message": {
                      "type": "string"
                    },
                    "meta": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "segment": {
                      "type": "string"
                    },
                    "segment_original": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "duplicate",
                        "collision",
                        "failed"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Upload accepted, collision-adjusted, or duplicate."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Upload request failed validation.",
            "x-reason-codes": [
              "protocol_version_required",
              "protocol_version_malformed",
              "field_missing",
              "envelope_invalid",
              "day_invalid",
              "segment_invalid",
              "multipart_malformed",
              "multipart_part_too_large"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "A linked-device identity is required.",
            "x-reason-codes": [
              "linked_device_required"
            ]
          },
          "409": {
            "content": {
              "application/json": {
